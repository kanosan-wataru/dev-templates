# Claude Code MCP サーバー用環境変数
# このファイルをコピーして ~/.claude/.env として使用してください
# cp .env.example ~/.claude/.env
#
# NOTE: Claude Code は envFile をネイティブサポートしていないため、
# シェルの起動時に読み込む必要があります（.zshenv 等で source）

# GitHub Copilot MCP トークン
GITHUB_COPILOT_TOKEN=

# Brave Search API キー
# https://brave.com/search/api/ から取得
BRAVE_API_KEY=

# Google Cloud プロジェクト ID（Gemini MCP 用）
GOOGLE_CLOUD_PROJECT=
