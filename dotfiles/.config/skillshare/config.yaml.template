# yaml-language-server: $schema=https://raw.githubusercontent.com/runkids/skillshare/main/schemas/config.schema.json
#
# Skillshare config (auto-generated by dev-templates setup.sh)
# プレースホルダー (__SKILLS_SOURCE__ / __HOME__) は setup.sh によって実行時に置換される。
# Claude は意図的に target から除外している (独立運用)。
source: __SKILLS_SOURCE__
agents_source: __AGENTS_SOURCE__
extras_source: __HOME__/.config/skillshare/extras
mode: merge
targets:
  codex:
    skills:
      path: __HOME__/.codex/skills
  gemini:
    skills:
      path: __HOME__/.gemini/skills
    agents:
      path: __HOME__/.gemini/agents
  opencode:
    skills:
      path: __HOME__/.config/opencode/skills
    agents:
      path: __HOME__/.config/opencode/agents
ignore:
  - '**/.DS_Store'
  - '**/.git/**'
audit:
  block_threshold: CRITICAL
