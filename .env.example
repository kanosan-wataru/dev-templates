# Claude Code
ANTHROPIC_API_KEY=

# Gemini CLI
GEMINI_API_KEY=

# GitHub Copilot CLI
# GH_TOKEN or GITHUB_TOKEN or COPILOT_GITHUB_TOKEN
# Fine-grained PAT に「Copilot Requests」権限が必要
GH_TOKEN=

# OpenAI API (Codex CLI / OpenAI 互換クライアント)
OPENAI_API_KEY=

# Google Cloud (Gemini / Vertex AI)
GOOGLE_CLOUD_PROJECT=

# Brave Search MCP
BRAVE_API_KEY=

# Docker bind mount のファイル所有をホストと一致させる
# 未指定時は 1000:1000。$(id -u) / $(id -g) で取得可能
# USER_UID=1000
# USER_GID=1000
